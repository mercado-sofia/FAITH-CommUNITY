# ============================================
# FAITH CommUNITY Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=db_community
MYSQL_CONNECTION_LIMIT=10

# For Railway MySQL (Production)
# MYSQL_SSL=true
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# ============================================
# SECURITY CONFIGURATION (Required)
# ============================================
# Generate strong secrets (minimum 32 characters):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-REPLACE-THIS
JWT_ISS=faith-community-api
JWT_AUD=faith-community-client
CSRF_SECRET=your-csrf-secret-key-minimum-32-characters-REPLACE-THIS

# ============================================
# FRONTEND CONFIGURATION (Required)
# ============================================
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# ============================================
# SMTP CONFIGURATION (Required for Email Features)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_SECURE=false
MAIL_FROM=FAITH CommUNITY <your-email@gmail.com>

# SMTP Timeout Configuration (Optional - defaults shown)
# Increase these if you experience connection timeouts
SMTP_VERIFICATION_TIMEOUT=60000
SMTP_CONNECTION_TIMEOUT=60000
SMTP_GREETING_TIMEOUT=60000
SMTP_SOCKET_TIMEOUT=60000

# SMTP TLS Configuration (Optional)
# Set to 'false' to disable TLS requirement (not recommended for production)
SMTP_REQUIRE_TLS=true
# Set to 'false' to allow self-signed certificates (development only)
SMTP_TLS_REJECT_UNAUTHORIZED=true

# SMTP Connection Pooling (Optional)
# Set to 'true' to enable connection pooling (default: false for verification)
SMTP_USE_POOL=false

# SMTP Debug Mode (Optional)
# Set to 'true' to enable detailed SMTP connection logging
SMTP_DEBUG=false

# Skip SMTP verification on startup (Optional - for development only)
# Set to 'true' to skip verification if you have network/firewall issues
SMTP_SKIP_VERIFY=false

# ============================================
# CLOUDINARY CONFIGURATION (Required for File Uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# AWS S3 CONFIGURATION (Optional - for Post Act Reports)
# ============================================
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=faith-community-files
AWS_CLOUDFRONT_URL=

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# PRODUCTION SECURITY CONFIGURATION
# ============================================
# Enable HSTS in production (only when behind HTTPS)
ENABLE_HSTS=false

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_MAX=1000
SLOWDOWN_GLOBAL_AFTER=200
SLOWDOWN_AUTH_AFTER=5

# ============================================
# COOKIE CONFIGURATION
# ============================================
COOKIE_SAMESITE=lax

# ============================================
# TOKEN CONFIGURATION
# ============================================
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=604800000
VERIFY_TTL_HOURS=24

# ============================================
# NOTES
# ============================================
# 1. For Gmail SMTP: Enable 2FA and generate an App Password
# 2. Generate strong secrets for JWT_SECRET and CSRF_SECRET (32+ characters)
# 3. For production: Set NODE_ENV=production and LOG_LEVEL=warn
# 4. For Railway: Use Railway MySQL variable references (${{MySQL.MYSQLHOST}}, etc.)
# 5. For Railway: Set MYSQL_SSL=true for MySQL connections

